{
  "name": "ordercontext-mcp-console",
  "version": "1.0.0",
  "private": true,
  "description": "Web console that shows what the OrderContext MCP server gives an AI assistant",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c magenta,cyan \"npm:dev:bridge\" \"npm:dev:web\"",
    "dev:bridge": "node --watch-path=bridge --import tsx bridge/server.ts",
    "dev:web": "vite",
    "bridge": "tsx bridge/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
